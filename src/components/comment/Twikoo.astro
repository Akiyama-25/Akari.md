---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const envId = commentConfig.twikoo?.envId ?? "";
const lang = commentConfig.twikoo?.lang ?? "zh-cn";
const region = commentConfig.twikoo?.region ?? "";
const path = Astro.props.path;
---

<div
	id="twikoo-container"
	class="twikoo-container"
	data-env-id={envId}
	data-lang={lang}
	data-region={region}
	data-path={path}
>
	<div id="tcomment"></div>
</div>

<style>
	.twikoo-container {
		min-height: 200px;
	}
</style>
